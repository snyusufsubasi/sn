# Bu dosya .env'in örnek halidir. Gerçek .env dosyasını oluşturup
# kendi anahtarlarını yaz. .env dosyası git'e gitmez.

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Google Maps (Faz 9'da gerekli)
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_WEB=

# iyzico (Faz 10'da gerekli — anahtarlar Supabase Edge Function'da tutulacak,
# istemci tarafında SADECE 3DS callback URL'leri kullanılır)
IYZICO_CALLBACK_BASE_URL=https://YOUR-PROJECT.supabase.co/functions/v1

# Demo modu
# true: gerçek Supabase yerine in-memory store kullanır (Faz 0/1 için)
# false: Supabase'e bağlanır
DEMO_MODE=true

# OTP demo bypass (yalnızca DEMO_MODE=true iken)
DEMO_OTP_CODE=123456
